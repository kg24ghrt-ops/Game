{
  "plugin": "org.smartide.plugin.framework.dart.flame",
  "run": "flutter build apk --debug && install-apk build/app/outputs/flutter-apk/app-debug.apk",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".dart": {
      "enabled": false,
      "run": "dart language-server --protocol=lsp --client-id=smartide"
    },
    ".yaml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    },
    ".yml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    }
  }
}